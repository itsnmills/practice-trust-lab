# Copy to .env and set values. scripts/bootstrap.sh does this for you and
# creates the file with mode 0600. Never commit .env.
SAMBA_ADMIN_PASS=change-me-admin
USER_TEMP_PASS=change-me-temp
TECH_PASS=change-me-tech

# Interface to bind published ports to. 127.0.0.1 keeps the lab local-only.
# Set to your VPN/tailnet IP to reach the lab from other machines.
#
# DANGER: 0.0.0.0 publishes anonymous LDAP, Kerberos, kpasswd, the global
# catalog and the unauthenticated mock EHR to every reachable interface on
# this host. Only use it on a throwaway machine on a trusted network.
LAB_BIND_IP=127.0.0.1

# Host uid/gid the mock EHR container runs as (so it can write its bind-mounted
# ./data directory without root). bootstrap.sh fills these in automatically.
LAB_UID=1000
LAB_GID=1000
